{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stac-extensions.github.io/maps/v1.0.0/schema.json#",
  "title": "Maps Extension",
  "description": "STAC Maps Extension for STAC Catalogs, STAC Collections and STAC Items.",
  "type": "object",
  "required": [
    "stac_extensions",
    "type"
  ],
  "properties": {
    "stac_extensions": {
      "type": "array",
      "contains": {
        "const": "https://stac-extensions.github.io/maps/v1.0.0/schema.json"
      }
    },
    "type": {
      "type": "string",
      "enum": [
        "Catalog",
        "Collection",
        "Feature"
      ]
    }
  }
}
